# Loopback Docker Compose fixtures. Generate a private file with
# node scripts/verification/local-env.mjs .local/fixture.env
# The generated file supplies the required credentials below.
MEDORA_DB_PASSWORD=
MEDORA_STORAGE_SECRET=
MEDORA_CODE_KEY=
MEDORA_MAIL_KEY=
MEDORA_PASSWORD_KEYS=

MEDORA_PORT=8808
MEDORA_MAIL_PORT=8810
MEDORA_PUBLIC_ORIGIN=http://127.0.0.1:8808
MEDORA_PAUSE_PUSH=true
MEDORA_LEGACY_WRITES_FENCED=false

# Optional fixture admin. Use an address registered in this fixture.
ADMIN_EMAIL=
# Independent session signing key required for administrative account actions.
EMAIL_SESSION_KEY=
