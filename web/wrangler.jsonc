{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medora",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PILOT", "class_name": "PushPilot" },
      { "name": "REMINDERS", "class_name": "MedicationReminders" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PushPilot"] },
    { "tag": "v2", "new_sqlite_classes": ["MedicationReminders"] }
  ]
}
