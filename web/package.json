{
  "name": "medora-web-pilot",
  "version": "0.5.0-preview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "predev": "npm run build",
    "dev": "wrangler dev",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "pilot:secrets": "node scripts/pilot-secrets.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "test:care": "node --test scripts/care-engine.check.mjs",
    "test:alarms": "node scripts/reminder-alarm.check.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261104.0-beta",
    "typescript": "5.9.3",
    "workbox-routing": "7.3.0",
    "wrangler": "4.158.0"
  }
}
