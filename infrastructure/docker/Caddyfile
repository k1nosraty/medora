:8080 {
	redir / /medication/ 302
	handle /api/v2/* {
		reverse_proxy api:8802
	}
	handle /api/* {
		reverse_proxy compatibility:8803
	}
	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
		}
		@plain not path /medication/ /admin/ /admin/preview/
		header @plain Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		@rich path /medication/ /admin/ /admin/preview/
		header @rich Content-Security-Policy "default-src 'self'; img-src 'self' https:; media-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		@shell path /sw.js /medication/* /admin/* /design/* /journal/ /journal/sw.js /journal/manifest.webmanifest
		header @shell Cache-Control "no-cache"
		@previews path /design/* /admin/preview/
		header @previews X-Robots-Tag "noindex"
		@assets path /journal/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}
}
