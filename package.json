{
  "name": "medora",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "build": "pnpm --filter @medora/web build && pnpm --filter @medora/api build",
    "test:e2e": "playwright test",
    "test:handoff": "node scripts/verification/postgres-handoff.mjs",
    "db:migrate": "node scripts/migration/apply.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/js": "^9",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "^5.108.0",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "fake-indexeddb": "^6",
    "jsdom": "^27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "dependencies": {
    "pg": "^8"
  }
}
