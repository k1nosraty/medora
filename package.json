{
  "name": "medora",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"*.config.ts\" \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "vitest run",
    "build": "pnpm --filter @medora/web build && pnpm --filter @medora/api build",
    "test:compat": "pnpm --filter @medora/compat-worker run typecheck && pnpm --filter @medora/compat-worker test && pnpm --filter @medora/compat-worker run test:care && pnpm --filter @medora/compat-worker run test:alarms",
    "test:product": "playwright test --config tests/browser/product.config.mjs",
    "test:e2e": "playwright test",
    "test:handoff": "node scripts/verification/postgres-handoff.mjs",
    "verify:source": "node scripts/verification/source-reconciliation.mjs",
    "verify:safari": "node scripts/verification/safari-insights.mjs",
    "db:migrate": "node scripts/migration/apply.mjs",
    "test:incumbent": "pnpm --filter @medora/compat-worker build && MEDORA_INCUMBENT_BROWSER=1 playwright test --config tests/browser/product.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@eslint/js": "^9",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "^5.108.0",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "fake-indexeddb": "^6",
    "jsdom": "^27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^4",
    "esbuild": "0.28.2",
    "miniflare": "5.20261104.0-beta",
    "wrangler": "4.158.0",
    "workbox-routing": "7.3.0"
  },
  "dependencies": {
    "pg": "^8"
  }
}
